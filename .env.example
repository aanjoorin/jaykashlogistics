## Example environment variables (redacted)
# Copy this file to .env and fill in real values. NEVER commit secrets.

# Supabase
VITE_SUPABASE_URL="https://your-supabase-url"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# EmailJS
VITE_EMAILJS_SERVICE_ID="your_emailjs_service_id"
VITE_EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
VITE_EMAILJS_TEMPLATE_ID="your_quote_template_id"
VITE_EMAILJS_BOOKING_TEMPLATE_ID="your_booking_template_id"

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
VITE_STRIPE_SECRET_KEY="sk_test_or_live_your_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# PayPal
VITE_PAYPAL_CLIENT_ID="your_paypal_client_id"

# Admin / App
VITE_ADMIN_EMAIL="admin@example.com"
VITE_ADMIN_PASSWORD="change_me"
VITE_PHONE="+10000000000"

# Zoho
VITE_ZOHO_CLIENT_ID="your_zoho_client_id"
VITE_ZOHO_CLIENT_SECRET="your_zoho_client_secret"
VITE_ZOHO_REFRESH_TOKEN="your_zoho_refresh_token"

# Notes:
# - Keep sensitive keys out of the repo. Use environment variables on hosting.
# - If a secret was accidentally committed, rotate it immediately.
